{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Pillsoon/webrecipe",
  "title": "webrecipe",
  "description": "Save how to read a public web page once, then fetch fresh items as JSON without a browser.",
  "repository": {
    "url": "https://github.com/Pillsoon/webrecipe",
    "source": "github"
  },
  "version": "0.1.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "webrecipe",
      "version": "0.1.4",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
